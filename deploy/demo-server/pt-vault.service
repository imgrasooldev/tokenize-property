[Unit]
Description=Property Token demo: document vault (encrypted offering and property documents; 127.0.0.1:4950 only)
After=pt-stack.service
Requires=pt-stack.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/property-token/backend
EnvironmentFile=/home/ubuntu/property-token/deploy/demo-server/stack.env
# Database login: VAULT_PG_USER from backend/.env.local (T-012, group pt_svc_vault; never the admin).
# Rollback to the admin login: bash deploy/demo-server/db-login.sh admin pt-vault
Environment=NODE_OPTIONS=--max-old-space-size=128
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs packages/vault/src/cli.ts serve
Restart=always
RestartSec=5
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
