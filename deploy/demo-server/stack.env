# Non-secret settings for the demo server's chain and database (read by pt-stack.service).
JAVA_HOME=/opt/jdk-25
# Four validators on a 4 GB box: small heaps, serial GC, no JIT tiers beyond C1 to save memory.
BESU_OPTS=-Xms128m -Xmx320m -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:MaxMetaspaceSize=192m
PATH=/opt/jdk-25/bin:/home/ubuntu/.foundry/bin:/usr/local/bin:/usr/bin:/bin
