[Unit]
Description=Property Token demo: notification worker (mock SMS and e-mail providers; reminders every minute; no NODE_ENV=production: mock providers only)
After=pt-stack.service
Requires=pt-stack.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/property-token/backend
EnvironmentFile=/home/ubuntu/property-token/deploy/demo-server/stack.env
# Database login: NOTIFY_PG_USER from backend/.env.local (T-012, group pt_svc_notify; never the admin).
# Rollback to the admin login: bash deploy/demo-server/db-login.sh admin pt-notify
Environment=NODE_OPTIONS=--max-old-space-size=128
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs packages/notify/src/cli.ts run
Restart=always
RestartSec=5
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
