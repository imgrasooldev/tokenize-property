[Unit]
Description=Property Token demo: S-04 transfer tick (bank + chain read model -> transfer cases -> outbox), every 60 s
After=pt-stack.service
Requires=pt-stack.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/property-token/backend
EnvironmentFile=/home/ubuntu/property-token/deploy/demo-server/stack.env
# Database login: TRANSFER_PG_USER from backend/.env.local (T-012, group pt_svc_transfer; never the admin).
# Rollback to the admin login: bash deploy/demo-server/db-login.sh admin pt-transfer
Environment=NODE_OPTIONS=--max-old-space-size=128
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs packages/transfer/src/cli.ts tick --loop
Restart=always
RestartSec=5
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
