# /etc/pt-ops/ops.env: NON-SECRET settings for deploy/ops (installed by install.sh, mode 0644).
# Parsed as KEY=VALUE (only PT_* keys), never executed. Environment variables win over this file.
# Secrets never go here: the database password is read from PT_PG_PASSWORD_FILE (one line only),
# the alert webhook URL lives in /etc/pt-ops/alert.env (mode 0640).

# ---- where things are
PT_REPO=/home/ubuntu/property-token
PT_STATE_DIR=/var/lib/pt-ops
PT_BACKUP_DIR=/var/backups/pt

# ---- PostgreSQL (the app cluster from backend/scripts/pg.py)
PT_PG_HOST=127.0.0.1
PT_PG_PORT=5433
PT_PG_USER=pt_admin
PT_PG_BINDIR=/usr/lib/postgresql/18/bin
# Space-separated list in double quotes when more than one.
PT_PG_DATABASES=property_token
# Only the PT_PG_PASSWORD_KEY line of this file is read. Production: a dedicated backup role in a
# pgpass file instead (PT_PG_PASSFILE=/etc/pt-ops/pgpass, mode 0600, owner of the backup user).
PT_PG_PASSWORD_FILE=/home/ubuntu/property-token/backend/.env.local
PT_PG_PASSWORD_KEY=PG_ADMIN_PASSWORD

# ---- backups: encrypted to a PUBLIC key; the private key stays offline
PT_BACKUP_ENCRYPTION=gpg
PT_BACKUP_RECIPIENT_FILE=/etc/pt-ops/backup-recipient.asc
PT_BACKUP_KEEP_HOURS=48
PT_BACKUP_KEEP_DAILY=7
PT_BACKUP_KEEP_WEEKLY=4
PT_BACKUP_KEEP_MONTHLY=12
PT_BACKUP_MIN_FREE_MB=1024
# Executable run after each successful set with the set directory as $1 (e.g. rsync to an
# append-only offsite host, or rclone to object storage with object lock). Empty = no offsite copy.
PT_OFFSITE_HOOK=
PT_BESU_KEEP=4

# ---- health check
# 1 once pt-backup-db.timer is enabled, so a missing backup is reported.
PT_BACKUP_EXPECTED=0
PT_HEALTH_DB=property_token
PT_RPC_URLS="http://127.0.0.1:8545 http://127.0.0.1:8546 http://127.0.0.1:8547 http://127.0.0.1:8548"
PT_HTTP_CHECKS="http://127.0.0.1/login=200 http://127.0.0.1:3100/login=200"
PT_CHAIN_SAMPLE_SECONDS=6
PT_NODE_LAG_WARN=5
PT_INDEXER_LAG_WARN=60
PT_INDEXER_LAG_CRIT=900
PT_OUTBOX_LEASE_STUCK_MIN=10
PT_OUTBOX_PENDING_WARN_MIN=15
PT_SIGNER_PENDING_WARN_MIN=60
PT_RECON_MAX_AGE_H=26
PT_ANCHOR_WARN_MIN=150
PT_ANCHOR_CRIT_MIN=360
PT_BACKUP_WARN_H=26
PT_BACKUP_CRIT_H=50
PT_DISK_WARN_PCT=80
PT_DISK_CRIT_PCT=90
PT_MEM_AVAIL_WARN_PCT=10
PT_SWAP_WARN_PCT=50
PT_SWAP_CRIT_PCT=85
PT_ALERT_REPEAT_MIN=60

# ---- scheduled jobs
PT_JOB_TIMEOUT_SECONDS=1800
