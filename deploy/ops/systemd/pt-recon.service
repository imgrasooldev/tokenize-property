[Unit]
Description=Property Token daily reconciliation (chain vs ledger vs bank); blocking findings freeze payouts
Documentation=file:///home/ubuntu/property-token/docs/runbooks/reconciliation-freeze.md
After=pt-stack.service
OnFailure=pt-ops-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=-/etc/pt-ops/ops.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Exit 1 = findings, 2 = error: both fail the unit on purpose (loud); see pt-job.sh.
ExecStart=/usr/local/lib/pt-ops/pt-job.sh recon
TimeoutStartSec=45min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
