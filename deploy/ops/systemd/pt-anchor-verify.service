[Unit]
Description=Property Token daily anchor verification (every public anchor vs Besu and the recomputed ledger)
Documentation=file:///home/ubuntu/property-token/docs/runbooks/anchor-alarm.md
After=pt-stack.service
OnFailure=pt-ops-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=-/etc/pt-ops/ops.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/lib/pt-ops/pt-job.sh anchor:verify
TimeoutStartSec=45min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
