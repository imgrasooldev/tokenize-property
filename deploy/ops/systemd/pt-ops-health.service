[Unit]
Description=Property Token health check (chain, indexer, outbox, signer, recon, anchor, backups, host, units, HTTP)
Documentation=file:///home/ubuntu/property-token/docs/OPERATIONS.md
After=network-online.target
OnFailure=pt-ops-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=-/etc/pt-ops/ops.env
ExecStart=/usr/local/lib/pt-ops/pt-health.sh --alert
# 1 = WARN and 2 = CRIT are results, not failures: pt-health.sh alerts itself (de-duplicated).
# Only 3 (the check itself broke) or a crash fails the unit and triggers OnFailure.
SuccessExitStatus=1 2
TimeoutStartSec=120
SupplementaryGroups=systemd-journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/pt-ops
