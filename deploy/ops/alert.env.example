# /etc/pt-ops/alert.env: the alert webhook (installed by install.sh as root:ubuntu, mode 0640).
# The URL usually carries a token: treat it as a secret, never commit a real one.
# Leave empty to alert to the journal only (journalctl -t pt-alert, or -u pt-ops-health).
# Any HTTPS endpoint that accepts JSON {"text": ...} works (self-hosted Mattermost/Rocket.Chat,
# a Slack-compatible incoming webhook, or your own receiver). Owner to choose the channel.
PT_ALERT_WEBHOOK_URL=
