# Secrets: never commit. Use .env.example for documented, non-secret defaults.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
keystore/
**/keys/

# Node / TypeScript
node_modules/
dist/
coverage/
*.tsbuildinfo

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
contracts/broadcast/**/dry-run/
contracts/lcov.info

# Local chain: binaries, node keys and data never go into git
chain/tools/
chain/data/
chain/**/database/
chain/network/nodes/*/key
chain/network/nodes/*/key.priv
chain/network/nodes/*/key.pub
chain/network/dev-accounts.env
chain/network/generated/

# Backend: portable PostgreSQL, local database files and env
backend/tools/
backend/data/
backend/**/.env
backend/**/.env.*
!backend/**/.env.example

# Flutter
mobile/.dart_tool/
mobile/build/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
contracts/broadcast/*/586586/
