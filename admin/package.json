{
  "name": "property-token-admin",
  "private": true,
  "description": "Internal portals (Step 6): operations, compliance, trustee and audit for officers; WebAuthn hardware keys only",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3300",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3300",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project unit --project db",
    "test:http": "vitest run --project http",
    "test:e2e": "node scripts/e2e-db.mjs && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "officer": "tsx tools/officer.ts",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-security": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
