{
  "name": "property-token-backend",
  "private": true,
  "description": "Backend services: ledger, outbox, signing service, indexer, reconciliation",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "migrate": "tsx packages/db/src/cli.ts",
    "gen:abis": "tsx packages/contracts/scripts/gen-abis.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "demo": "tsx packages/demo-console/src/server.ts",
    "signer": "tsx packages/signer/src/cli.ts serve",
    "signer:setup": "tsx packages/signer/src/cli.ts setup",
    "signer:decide": "tsx packages/signer/src/cli.ts decide",
    "signer:audit": "tsx packages/signer/src/cli.ts audit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "eslint-plugin-security": "4.2.0",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "pg": "8.23.1",
    "pino": "10.4.0",
    "viem": "2.57.4",
    "zod": "4.6.5"
  }
}
