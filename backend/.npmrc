# Supply-chain hardening (threat SUP-1)
# Pin exact versions; never let a range pull in a new release silently.
save-exact=true
# Do not run dependency install scripts (a common malware vector). Packages that truly need a
# build step must be allow-listed and justified in the PR.
ignore-scripts=true
# Refuse to install on an unsupported Node version.
engine-strict=true
audit-level=high
fund=false
