# Deployment configuration for script/Deploy.s.sol. Copy to .env.local, fill in, never commit.
# All values are public addresses. No private keys belong in this file.

RPC_URL=http://127.0.0.1:8545

# Temporary deployer (encrypted keystore or hardware wallet). Holds no powers after deployment.
DEPLOYER=0x0000000000000000000000000000000000000000

# Safe multisigs
ADMIN_SAFE=0x0000000000000000000000000000000000000000      # 3-of-5
TRUSTEE_SAFE=0x0000000000000000000000000000000000000000    # 2-of-3, trustee officers
ISSUANCE_SAFE=0x0000000000000000000000000000000000000000   # 2-of-3, at least one trustee signer
OPS_SAFE=0x0000000000000000000000000000000000000000        # 2-of-3

# Hot keys (HSM-backed in production)
PAUSER=0x0000000000000000000000000000000000000000
REGISTRAR=0x0000000000000000000000000000000000000000
IDENTITY_OPERATOR=0x0000000000000000000000000000000000000000
CLAIM_SIGNER=0x0000000000000000000000000000000000000000
CLAIM_ISSUER_MANAGER=0x0000000000000000000000000000000000000000   # usually the Admin Safe

# Parameters
TIMELOCK_DELAY=259200            # seconds; minimum 72h, enforced
REGISTRAR_MAX_PER_HOUR=50
MAX_BALANCE=100000               # per investor, in token units (10% of a 1,000,000-unit register)
ALLOWED_COUNTRIES=586            # ISO 3166 numeric, comma-separated (586 = Pakistan)

# Property
TOKEN_SALT=GPF3
TOKEN_NAME=Gulberg Plaza Floor 3
TOKEN_SYMBOL=GPF3
